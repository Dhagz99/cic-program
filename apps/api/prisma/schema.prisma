// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User{
  id              String  @id @default(uuid())
  email           String? @unique
  name            String
  username        String @unique @db.VarChar(100)
  password        String 

  isActive        Boolean   @default(true)
  branchId        String?


  createdAt       DateTime    @default(now())
  updateAt        DateTime?    @updatedAt


  branch          Branch? @relation(fields: [branchId], references: [id])
  roles           UserRole[]
  uploadedBatches ImportBatch[]
  auditLogs       AuditLog[]

  submittedBatches ImportBatch[] @relation("SubmittedBy")

  approvedBatches ImportBatch[] @relation("ApprovedBy")     

  returnedBatches ImportBatch[]   @relation("ReturnedBy")

  rejectedBatches ImportBatch[]  @relation("BatchRejectedBy")

  @@map("user")
}

model Branch {
  id              String   @id @default(uuid())
  
  branchCode      String   @unique
  branchName      String
  users           User[]
  importBatches   ImportBatch[]
  clients         Client[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


model Role {
  id        String       @id @default(uuid())
  name      String    @unique
  description  String?

  users   UserRole[]
  permissions  RolePermission[]
}

model UserRole {
  userId    String
  roleId   String


  user    User @relation(fields: [userId], references: [id])
  role    Role  @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}


model Permission {
  id   String      @id @default(uuid())
  code String @unique
  name String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}




enum PenType {
  SD
  EC
  RT
}


model CicData {
  id              String             @id @default(uuid())
  accountId       Int
  firstName       String
  lastName        String
  middleName      String
  // bank            String
  // birthDate       DateTime?      @db.Date
  // inDate          DateTime?     @db.Date
  // accountPension  Decimal?      @db.Decimal(10,2) 
  // pension         Decimal       @db.Decimal(10,2) 
  // branch          String
  // change          Decimal       @default(0.00) @db.Decimal(10,2)
  // balanceAmount   Decimal       @default(0.00) @db.Decimal(10,2)
  // pentionType     PenType
  // mark            Boolean       @default(false)
  // balanceTerm     Int           @default(0)

}


enum ReportingStatus {
  OPEN
  CLOSED
  FINALIZED
}

model ReportingPeriod {
  id              String   @id @default(uuid())

  month           Int
  year            Int

  status          ReportingStatus

  batches         ImportBatch[]
  snapshots       ContractMonthlySnapshot[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([month, year])
}


enum ImportStatus {
  UPLOADED
  PROCESSING
  PENDING_COMPLETION
  FOR_REVIEW
  RETURNED
  APPROVED
  FINALIZED
  REJECTED
}

model ImportBatch {
  id                  String   @id @default(uuid())

  branchId            String
  reportingPeriodId   String
  uploadedById        String

  fileName            String
  originalFilePath    String

  status              ImportStatus

  totalRecords        Int      @default(0)
  completedRecords    Int      @default(0)
  errorRecords        Int      @default(0)

  submittedAt         DateTime?
  submittedById       String?

  approvedAt          DateTime?
  approvedById        String?

  returnedAt          DateTime?
  returnedById        String?

  returnReason        String?

  rejectedAt          DateTime?
  rejectedById        String?

  rejectionReason     String?

  branch              Branch @relation(fields: [branchId], references: [id])

  reportingPeriod     ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  uploadedBy          User  @relation(fields: [uploadedById], references: [id])

  submittedBy User? @relation(  "SubmittedBy", fields: [submittedById],  references: [id] )

  approvedBy User? @relation("ApprovedBy", fields: [approvedById], references: [id] )

  returnedBy User?@relation( "ReturnedBy", fields: [returnedById],references: [id])

  rejectedBy User?  @relation( "BatchRejectedBy", fields: [rejectedById],  references: [id] )

  stagingClients      StagingClient[]
  stagingContracts    StagingContract[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([branchId, reportingPeriodId])
}


enum ValidationStatus {
  COMPLETE
  INCOMPLETE
  WITH_ERRORS
}

enum AddressType {
  MI
  AI
}


model GenderDomain {

  code          String   @id
  description   String

  stagingCLients       StagingClient[]

  @@map("gender_domain")

}

model CivilStatusDomain {

  code          Int      @id
  description   String

   stagingCLients       StagingClient[]

  @@map("civil_status_domain")

}

model IdentificationTypeDomain {

  code          Int      @id
  description   String

   stagingCLients       StagingClient[]

  @@map("identification_type_domain")

}

