// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User{
  id              String  @id @default(uuid())
  email           String? @unique
  name            String
  username        String @unique @db.VarChar(100)
  password        String 

  isActive        Boolean   @default(true)
  branchId        String?


  createdAt       DateTime    @default(now())
  updateAt        DateTime?    @updatedAt


  branch          Branch? @relation(fields: [branchId], references: [id])
  roles           UserRole[]
  uploadedBatches ImportBatch[]
  auditLogs       AuditLog[]

  submittedBatches ImportBatch[] @relation("SubmittedBy")

  approvedBatches ImportBatch[] @relation("ApprovedBy")     

  returnedBatches ImportBatch[]   @relation("ReturnedBy")

  rejectedBatches ImportBatch[]  @relation("BatchRejectedBy")

  @@map("user")
}

model Branch {
  id              String   @id @default(uuid())
  
  branchCode      String   @unique
  branchName      String
  users           User[]
  importBatches   ImportBatch[]
  clients         Client[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


model Role {
  id        String       @id @default(uuid())
  name      String    @unique
  description  String?

  users   UserRole[]
  permissions  RolePermission[]
}

model UserRole {
  userId    String
  roleId   String


  user    User @relation(fields: [userId], references: [id])
  role    Role  @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}


model Permission {
  id   String      @id @default(uuid())
  code String @unique
  name String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}




enum PenType {
  SD
  EC
  RT
}


model CicData {
  id              String             @id @default(uuid())
  accountId       Int
  firstName       String
  lastName        String
  middleName      String
  // bank            String
  // birthDate       DateTime?      @db.Date
  // inDate          DateTime?     @db.Date
  // accountPension  Decimal?      @db.Decimal(10,2) 
  // pension         Decimal       @db.Decimal(10,2) 
  // branch          String
  // change          Decimal       @default(0.00) @db.Decimal(10,2)
  // balanceAmount   Decimal       @default(0.00) @db.Decimal(10,2)
  // pentionType     PenType
  // mark            Boolean       @default(false)
  // balanceTerm     Int           @default(0)

}


enum ReportingStatus {
  OPEN
  CLOSED
  FINALIZED
}

model ReportingPeriod {
  id              String   @id @default(uuid())

  month           Int
  year            Int

  status          ReportingStatus

  batches         ImportBatch[]
  snapshots       ContractMonthlySnapshot[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([month, year])
}


enum ImportStatus {
  UPLOADED
  PROCESSING
  PENDING_COMPLETION
  FOR_REVIEW
  RETURNED
  APPROVED
  FINALIZED
  REJECTED
}

model ImportBatch {
  id                  String   @id @default(uuid())

  branchId            String
  reportingPeriodId   String
  uploadedById        String

  fileName            String
  originalFilePath    String

  status              ImportStatus

  totalRecords        Int      @default(0)
  completedRecords    Int      @default(0)
  errorRecords        Int      @default(0)

  submittedAt         DateTime?
  submittedById       String?

  approvedAt          DateTime?
  approvedById        String?

  returnedAt          DateTime?
  returnedById        String?

  returnReason        String?

  rejectedAt          DateTime?
  rejectedById        String?

  rejectionReason     String?

  branch              Branch @relation(fields: [branchId], references: [id])

  reportingPeriod     ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  uploadedBy          User  @relation(fields: [uploadedById], references: [id])

  submittedBy User? @relation(  "SubmittedBy", fields: [submittedById],  references: [id] )

  approvedBy User? @relation("ApprovedBy", fields: [approvedById], references: [id] )

  returnedBy User?@relation( "ReturnedBy", fields: [returnedById],references: [id])

  rejectedBy User?  @relation( "BatchRejectedBy", fields: [rejectedById],  references: [id] )

  stagingClients      StagingClient[]
  stagingContracts    StagingContract[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([branchId, reportingPeriodId])
}


enum ValidationStatus {
  COMPLETE
  INCOMPLETE
  WITH_ERRORS
}

model StagingClient {
  id                    String   @id @default(uuid())

  batchId               String

  providerSubjectNo     String?

  firstName             String?
  middleName            String?
  lastName              String?
  suffix                String?

  birthDate             DateTime?

  gender                String?
  civilStatus           String?

  address               String?
  tinNumber             String?


  validationStatus      ValidationStatus

  isConfirmed           Boolean @default(false)

  batch                 ImportBatch  @relation(fields: [batchId], references: [id])

  stagingContracts      StagingContract[]

  validationErrors      ValidationError[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}


model StagingContract {
  id                    String   @id @default(uuid())

  batchId               String
  stagingClientId       String

  contractNo            String?

  contractStatus        String?

  financedAmount        Decimal? @db.Decimal(18,2)

  contractStartDate     DateTime?
  contractEndDate       DateTime?

  lastPaymentDate       DateTime?

  validationStatus      ValidationStatus

  isConfirmed Boolean @default(false)

  batch                 ImportBatch @relation(fields: [batchId], references: [id])

  stagingClient         StagingClient @relation(fields: [stagingClientId], references: [id])
  

  validationErrors      ValidationError[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}


model ValidationError {
  id                    String   @id @default(uuid())

  stagingClientId       String?
  stagingContractId     String?

  fieldName             String
  errorMessage          String

  stagingClient         StagingClient?  @relation(fields: [stagingClientId], references: [id])

  stagingContract       StagingContract?  @relation(fields: [stagingContractId], references: [id])

  createdAt             DateTime @default(now())
}


model Client {
  id                    String   @id @default(uuid())

  branchId              String

  providerSubjectNo     String?  @unique

  firstName             String
  middleName            String?
  lastName              String

  suffix                String?

  birthDate             DateTime?

  gender                String?
  civilStatus           String?

  address               String?
  tinNumber             String?

  branch                Branch @relation(fields: [branchId], references: [id])

  contracts             Contract[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Contract {
  id                    String   @id @default(uuid())

  clientId              String

  contractNo            String   @unique

  client                Client  @relation(fields: [clientId], references: [id])

  monthlySnapshots      ContractMonthlySnapshot[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum ContractStatus {
  CURRENT
  PAST_DUE
  RESTRUCTURED
  CLOSED
  WRITTEN_OFF
}

model ContractMonthlySnapshot {
  id                    String   @id @default(uuid())

  contractId            String
  reportingPeriodId     String

  contractStatus        ContractStatus

  financedAmount        Decimal? @db.Decimal(18,2)
  balanceAmount         Decimal? @db.Decimal(18,2)

  lastPaymentDate       DateTime?

  contract              Contract @relation(fields: [contractId], references: [id])

  reportingPeriod       ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([contractId, reportingPeriodId])
}

model AuditLog {
  id                    String   @id @default(uuid())

  userId                String

  module                String
  action                String

  referenceId           String?

  oldValues             Json?
  newValues             Json?

  user                  User  @relation(fields: [userId], references: [id])

  createdAt             DateTime @default(now())
}