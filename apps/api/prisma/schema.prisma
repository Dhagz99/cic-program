//   @@map("occupation_status_domain")

// }


model StagingClient {
  id                                String    @id @default(uuid())
  recordType                        String    @default("ID")
  batchId                           String
  providerCode                      String?   @default("PF007980")
  branchCode                        String?
  subjectRefeerenceDate             DateTime?
  providerSubjectNo                 String?
  title                             String?

  firstName                         String?
  middleName                        String?
  lastName                          String?
  suffix                            String?
  nickname                          String?
  
  prevLastName                      String?
  genderCode                        String?
  birthDate                         DateTime 
  placeOfBirth                      String?
  countryOfBirthCode                String?   @default("PH")
  nationality                       String?   @default("PH")
  resident                          Boolean?   @default(true)
  civilStatusCode                   Int?
  numberOfDependents                Int    @default(0)

  addressType                       AddressType    @default(MI)
  address                           String?

  addressType2                      AddressType    @default(AI)
  address2                          String?

  identificationTypeCode            Int
  identificationNumber              String?

  contactType                       String?
  contactValue                      String?

  validationStatus        ValidationStatus

  isConfirmed           Boolean @default(false)

  batch                 ImportBatch  @relation(fields: [batchId], references: [id])

  stagingContracts      StagingContract[]

  validationErrors      ValidationError[]

  civilStatus            CivilStatusDomain? @relation( fields: [civilStatusCode], references: [code])
  identificationType    IdentificationTypeDomain @relation( fields: [identificationTypeCode], references: [code])
  gender                 GenderDomain? @relation( fields: [genderCode], references: [code])

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}


model StagingContract {
  id                          String   @id @default(uuid())
  recordType                  String    @default("CI")
  providerCode                String?   @default("PF007980")
  branchCode                  String?
  batchId                     String
  stagingClientId             String
  providerSubjectNo           String?
  role                        String      @default("B")

  contractNo                  String?
  contractType                Int?        @default(15)
  contractPhase               String?     @default("AC")
  contractStatus              String?

  currency                    String?     @default("PHP")
  originalCurrency            String?     @default("PHP")

  contractStartDate           DateTime?
  contractRequestDate         DateTime?

  contractEndPlannedDate      DateTime?
  contractEndActualDate       DateTime?

  lastPaymentDate             DateTime?


  financedAmount              Decimal? @db.Decimal(18,2)
  installmentsNumber          Int?

  transactionType             String? @default("NA")

  paymentPeriodicity          String? @default("M")
  paymentMethod               String? @default("OTH")

  monthlyPaymentAmount        Decimal? @db.Decimal(18,2)

  firstPaymentDate            DateTime?
  lastPaymentAmount           Decimal? @db.Decimal(18,2)
  nextPaymentDate             DateTime?
  nextPaymentAmount           Decimal? @db.Decimal(18,2)
  outstandingPaymentNumber    Int?
  outstandingBalance          Decimal? @db.Decimal(18,2)

  overduePaymentNumber        Int?
  overduePaymentAmount        Decimal? @db.Decimal(18,2)


  validationStatus            ValidationStatus

  isConfirmed                 Boolean @default(false)

  batch                       ImportBatch @relation(fields: [batchId], references: [id])

  stagingClient               StagingClient @relation(fields: [stagingClientId], references: [id])
  

  validationErrors            ValidationError[]

  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}


model ValidationError {
  id                    String   @id @default(uuid())

  stagingClientId       String?
  stagingContractId     String?

  fieldName             String
  errorMessage          String

  stagingClient         StagingClient?  @relation(fields: [stagingClientId], references: [id])

  stagingContract       StagingContract?  @relation(fields: [stagingContractId], references: [id])

  createdAt             DateTime @default(now())
}


model Client {
  id                    String   @id @default(uuid())

  branchId              String

  providerSubjectNo     String?  @unique

  firstName             String
  middleName            String?
  lastName              String

  suffix                String?

  birthDate             DateTime?

  gender                String?
  civilStatus           String?

  address               String?
  tinNumber             String?

  branch                Branch @relation(fields: [branchId], references: [id])

  contracts             Contract[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Contract {
  id                    String   @id @default(uuid())

  clientId              String

  contractNo            String   @unique

  client                Client  @relation(fields: [clientId], references: [id])

  monthlySnapshots      ContractMonthlySnapshot[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum ContractStatus {
  CURRENT
  PAST_DUE
  RESTRUCTURED
  CLOSED
  WRITTEN_OFF
}

model ContractMonthlySnapshot {
  id                    String   @id @default(uuid())

  contractId            String
  reportingPeriodId     String

  contractStatus        ContractStatus

  financedAmount        Decimal? @db.Decimal(18,2)
  balanceAmount         Decimal? @db.Decimal(18,2)

  lastPaymentDate       DateTime?

  contract              Contract @relation(fields: [contractId], references: [id])

  reportingPeriod       ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([contractId, reportingPeriodId])
}

model AuditLog {
  id                    String   @id @default(uuid())

  userId                String

  module                String
  action                String

  referenceId           String?

  oldValues             Json?
  newValues             Json?

  user                  User  @relation(fields: [userId], references: [id])

  createdAt             DateTime @default(now())
}